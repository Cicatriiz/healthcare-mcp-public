# FDA API Key (optional - increases rate limits)
FDA_API_KEY=

# Google Maps API Key (optional - improves geocoding accuracy)
# Get one at: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=

# Cache TTL in seconds (default: 86400 = 24 hours)
CACHE_TTL=86400

# Server Port
PORT=3000
